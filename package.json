{
  "name": "citysync-backend",
  "version": "1.0.0",
  "description": "CitySync: fuses live civic data feeds into one normalized event stream with a global/local (Amer, Jaipur) geo-filter.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "start:mock": "node server.js --mock",
    "dev": "node --watch server.js",
    "build:wards": "node scripts/convert-wards.js",
    "build:exposure": "node scripts/fetch-exposure.js",
    "build:places": "node scripts/geocode-hotspots.js",
    "build:jctsl": "node scripts/fetch-jctsl-ptal.js",
    "build:worldpop": "node scripts/fetch-worldpop.js",
    "build:destinations": "node scripts/geocode-destinations.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@google/earthengine": "^1.7.45",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "geotiff": "^3.0.5"
  }
}
