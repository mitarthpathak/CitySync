# Copy to .env to override. Both are optional; defaults shown.

# Port the API listens on.
PORT=3000

# true  = serve ONLY events.json, make no network calls (offline demo).
# false = live feeds, with events.json as per-feed fallback.
USE_MOCK=false

# Optional live-source credentials. Leave blank to keep the matching source explicitly disabled.
# Never commit a populated .env file.
WAQI_TOKEN=
TOMTOM_KEY=

# Deferred/enterprise-provider access, required before these can be genuinely implemented/live.
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY=
MOSDAC_API_KEY=
BHUVAN_API_KEY=
IUDX_AUTH_TOKEN=
MAPPLS_CLIENT_ID=
MAPPLS_CLIENT_SECRET=
JCTSL_API_KEY=
WORLDPOP_API_KEY=
