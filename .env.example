# Copy to .env to override. Everything below is optional; every key has a safe default,
# and a missing key just marks the matching source "disabled" in /health and /api/sources
# - the app always runs. Never commit a populated .env (it's already in .gitignore).
# Every one of these is read ONLY through lib/config.js; nothing reads process.env
# directly, and no key is ever logged or returned in an API response.

# ---- Runtime ----
PORT=3000
# true  = serve ONLY events.json, make no network calls (offline demo).
# false = live feeds, with events.json as per-feed fallback.
USE_MOCK=false

# ---- Ground air quality ----
# WAQI ground-station AQI (Jaipur stations + a slice of the world city grid).
# Get a free token at https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here

# ---- Traffic ----
# TomTom traffic flow + incidents (Jaipur points + a few world cities). Free tier is
# 2,500 requests/day; the adapter polls on its own timer and tracks the daily count itself.
# Get a key at https://developer.tomtom.com/
TOMTOM_KEY=your_tomtom_key_here

# ---- India geocoding / routing (optional, Tier 2 - not yet wired to a live adapter) ----
# Mappls may require a client id/secret OAuth flow rather than a single key; if this
# doesn't authenticate, the source just reports "disabled", never crashes.
MAPPLS_API_KEY=your_mappls_key_here

# ---- ISRO Bhuvan (optional, Tier 2 - not yet wired to a live adapter) ----
BHUVAN_KEY=your_bhuvan_key_here

# ---- Optional tuning (defaults shown / off) ----
# GDELT_MIN_GAP_MS=10000          # spacing between GDELT requests (GDELT allows ~1 per 5 s)
# GDELT_QUERIES="flood=(flood OR flooding)|wildfire=wildfire"   # label=query|label=query
# DISABLE_NASA_POWER=true         # Tier 2: NASA POWER daily climate layer
# DISABLE_ANOMALY=true            # Tier 2: Open-Meteo archive temperature anomalies

# ---- Deferred: needs enterprise/GCP auth or a Python geospatial toolchain, not built ----
# Always shown "disabled" in /api/sources with a note; see connectors/*.js.
EARTH_ENGINE_PROJECT=
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY=
MOSDAC_API_KEY=
IUDX_AUTH_TOKEN=
JCTSL_API_KEY=
WORLDPOP_API_KEY=
